{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "env": {}
    },
    "supabase": {
      "type": "local",
      "command": [
        "cmd", "/c",
        "npx", "-y", "@supabase/mcp-server-supabase@latest",
        "--project-ref=qqhjeumlecaudsiqhhdu"
      ],
      "enabled": true,
      "env": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}