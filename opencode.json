{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "env": {}
    },
    "supabase": {
      "type": "local",
      "command": ["node", ".opencode/supabase-mcp.mjs"],
      "cwd": ".",
      "enabled": true
    }
  }
}