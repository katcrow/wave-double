# wave-double 환경변수 체크리스트 (spec-1-11)
# 이 파일은 `.env.local`(미버전관리)의 키 이름과 용도만 이식한다 -- 값은 절대 채우지 않는다.
# Vercel 배포 시 아래 키를 전부 Vercel Dashboard > Project > Settings > Environment Variables에
# 등록해야 한다(Vercel은 `.env.local`을 읽지 않는다 -- docs/deployment.md 참고).

# --- SUPABASE CONFIGURATION ---
# Supabase 프로젝트 URL. 브라우저에 노출되는 값(NEXT_PUBLIC_* 접두사)이지만 secret은 아니다.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable(anon) key. 브라우저 노출 가능한 공개 키다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 Supabase URL(NEXT_PUBLIC_SUPABASE_URL과 동일 값이어도 서버 코드 경로 명시용으로 분리).
SUPABASE_URL=
# 서버 전용 publishable(anon) key.
SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key -- RLS를 우회하는 server-only secret. 절대 NEXT_PUBLIC_*로 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# `/api/dispatch`가 JWT 서명 검증에 쓰는 Supabase JWKS 엔드포인트 URL.
SUPABASE_JWKS_URL=
# `/api/dispatch`가 JWT `iss` 클레임 검증에 쓰는 issuer 값.
SUPABASE_JWT_ISSUER=
# Supabase CLI/관리 API 접근 토큰(로컬 개발/마이그레이션 작업용).
SUPABASE_ACCESS_TOKEN=
# 미사용 -- CRON_CALLBACK_SECRET(아래)과 같은 용도의 값을 담는 자리였으나 outbox worker
# route(/api/dispatch/worker)는 실제로 CRON_CALLBACK_SECRET만 비교한다. 혼동 방지를 위해
# 이름만 남겨두되 값은 CRON_CALLBACK_SECRET과 동일하게 채워도 무방하다(둘 다 쓰이는 곳은
# CRON_CALLBACK_SECRET 하나뿐).
INTERNAL_CRON_SECRET=

# --- Story 1.10: 인증 & 수동 트리거 ---
# `/api/dispatch`에서 수동 실행을 허용할 운영자 이메일 allowlist(콤마 구분).
OPERATOR_ALLOWLIST=
# GitHub Actions workflow_dispatch 및 dead_letter Issue 생성에 쓰는 PAT.
# 필요 권한: Actions(Read/Write), Issues(Read/Write) -- 하나라도 빠지면 해당 호출만 조용히 실패한다.
GITHUB_DISPATCH_TOKEN=
# 실사용: pg_cron이 매 1분 `/api/dispatch/worker`를 호출할 때 보내는 `x-cron-secret` 헤더 값과
# 비교하는 secret. 위 INTERNAL_CRON_SECRET과 같은 값을 가리키는 서로 다른 이름이지만,
# 코드에서 실제로 읽는 것은 이 CRON_CALLBACK_SECRET 하나뿐이다.
CRON_CALLBACK_SECRET=
# GitHub workflow_dispatch/Issue 생성 대상 저장소 소유자.
GITHUB_REPO_OWNER=
# GitHub workflow_dispatch/Issue 생성 대상 저장소 이름.
GITHUB_REPO_NAME=

# --- LS Open API credentials — server-side only ---
# LS증권 Open API 앱 키.
LS_OPEN_API_APP_KEY=
# LS증권 Open API 앱 시크릿.
LS_OPEN_API_APP_SECRET=
# LS증권 조건검색에 사용하는 사용자 ID.
LS_CONDITION_SEARCH_USER_ID=
